# Copy to .env and fill in. Never commit .env.

# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Groq backup (free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b


# Order to try LLM providers in. Providers without a key are skipped.
LLM_ORDER=gemini,groq

# Disk cache for API responses, so development doesn't burn free quota.
KAHAANI_CACHE_DIR=.cache
KAHAANI_CACHE=1

# Vision checks (image safety, consistency judge). Gemini models, tried in order.
VISION_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash

# Images: Cloudflare Workers AI (free daily allowance).
# dash.cloudflare.com -> My Profile -> API Tokens -> "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# flux-2-klein-4b accepts the hero picture as a reference (best consistency).
# flux-1-schnell is text-only.
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# cloudflare | placeholder (offline shapes, for development) | diffusers (GPU, Kaggle/Colab)
# Defaults to cloudflare when the two values above are set, otherwise placeholder.
IMAGE_PROVIDER=

# Narration speed for edge-tts. Slightly slow sounds better at bedtime.
TTS_RATE=-10%

# 1 = refuse to deliver a book if the image safety check can't run.
REQUIRE_IMAGE_CHECK=0

# Accounts and saved books (Supabase: Google sign-in, Postgres, private file storage).
# Leave these empty for local development: a SQLite file and a folder under .data/ are used.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Supabase -> Project settings -> Database -> Connection string (URI), "psycopg" driver:
# postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-...pooler.supabase.com:5432/postgres
DATABASE_URL=
# Only for projects using legacy shared-secret tokens (newer projects use signing keys).
SUPABASE_JWT_SECRET=
# Any long random string; signs the short-lived links to pictures and downloads.
KAHAANI_URL_SECRET=

# Limits.
BOOKS_PER_DAY=3
GLOBAL_BOOKS_PER_DAY=60

# Local development only: sign in without Google (ignored when SUPABASE_URL is set).
KAHAANI_DEV_AUTH=0
